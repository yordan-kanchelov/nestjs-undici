{
  "name": "nestjs-axios-undici",
  "version": "0.6.1",
  "description": "Drop-in @nestjs/axios replacement built on Undici: the same HttpModule/HttpService API and axios-compatible responses, errors and interceptors, with much lower latency.",
  "homepage": "https://yordan-kanchelov.github.io/nestjs-axios-undici/",
  "type": "commonjs",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "serve:website": "npx docsify-cli serve .",
    "generate:version": "node scripts/generate-version.js",
    "prebuild": "npm run generate:version",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "pretypecheck": "npm run generate:version",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:compat": "npm run build && tsc -p tests/types/tsconfig.json",
    "api:check": "npm run build && api-extractor run --verbose",
    "api:update": "npm run build && api-extractor run --local --verbose",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint",
    "test": "npm run test:jest && npm run test:examples",
    "pretest:jest": "npm run generate:version",
    "test:jest": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:unit": "npm run test:jest -- src/",
    "test:e2e": "npm run test:jest -- tests/",
    "test:watch": "npm run test:jest -- --watch",
    "test:cov": "npm run test:jest -- --coverage",
    "test:debug": "npm run generate:version && node --inspect-brk --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
    "test:examples": "npm run build && node scripts/run-examples.js",
    "test:upstream": "node tests/upstream/run-all.mjs",
    "test:upstream:nestjs": "node tests/upstream/nestjs-axios/run.mjs",
    "test:upstream:axios": "node tests/upstream/axios/run.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.2",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/testing": "^12.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "axios": "^1.20.0",
    "axios-auth-refresh": "^5.0.2",
    "axios-mock-adapter": "^2.1.0",
    "axios-retry": "^4.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "form-data": "^4.0.6",
    "globals": "^17.12.0",
    "http-cookie-agent": "^8.0.0",
    "jest": "^30.5.2",
    "nock": "^14.0.5",
    "prettier": "^3.9.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2",
    "tough-cookie": "^5.1.2 || ^6.0.0",
    "ts-jest": "^29.4.13",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "undici": "^7.30.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "axios": "^1.0.0",
    "http-cookie-agent": "^8.0.0",
    "rxjs": "^7.1.0",
    "tough-cookie": "^5.1.2 || ^6.0.0",
    "undici": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "http-cookie-agent": {
      "optional": true
    },
    "tough-cookie": {
      "optional": true
    }
  },
  "contributors": [
    {
      "name": "Hebert Cisco <hebertcisco@outlook.com>",
      "url": "https://github.com/hebertcisco",
      "author": true
    },
    {
      "name": "binsee",
      "url": "https://github.com/binsee",
      "author": false
    },
    {
      "name": "shevchenkonik",
      "url": "https://github.com/shevchenkonik",
      "author": false
    },
    {
      "name": "favelado-web",
      "url": "https://github.com/favelado-web",
      "author": false
    }
  ],
  "files": [
    "lib",
    "src",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "nestjs",
    "nest",
    "axios",
    "@nestjs/axios",
    "undici",
    "http",
    "http-client",
    "httpmodule",
    "httpservice",
    "drop-in",
    "interceptors",
    "fast"
  ],
  "author": {
    "name": "Yordan Kanchelov",
    "url": "https://github.com/yordan-kanchelov"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yordan-kanchelov/nestjs-axios-undici.git"
  },
  "bugs": {
    "url": "https://github.com/yordan-kanchelov/nestjs-axios-undici/issues"
  }
}
