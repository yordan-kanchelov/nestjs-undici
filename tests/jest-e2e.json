{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "forceExit": true,
  "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
  "globalTeardown": "<rootDir>/jest.teardown.js",
  "testTimeout": 10000
}
