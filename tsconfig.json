{
  // Editor, ts-jest and `npm run typecheck` (src + tests). The build uses tsconfig.build.json.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "node20",
    "types": ["node", "jest"],

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    "strict": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./lib",
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["src", "tests"],
  // tests/types is a separate, --strict, compile-only project against the
  // built package (see tests/types/tsconfig.json / `npm run typecheck:compat`),
  // kept out of both this loose typecheck and Jest.
  "exclude": ["tests/types"]
}
